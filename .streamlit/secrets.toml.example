# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요.
# secrets.toml 은 git에 커밋하지 않습니다 (.gitignore).
# 아래 값은 예시이며, 실제 웹훅 URL이나 API 키를 넣지 마세요.

# Discord 알림. SSO(pages/1_SSO.py), stochastic.py, AI 종합분석이
# 같은 웹훅을 사용합니다. 페이지마다 URL이 달랐다면 키를 나눴을 것입니다.
# 환경변수 DISCORD_WEBHOOK_URL 이 설정되어 있으면 그 값이 우선합니다.
# 둘 다 없으면 Discord 전송만 건너뛰고 대시보드는 그대로 동작합니다.
DISCORD_WEBHOOK_URL = ""

# 앱이 이미 읽는 다른 시크릿 (이번 변경과 무관). 필요한 값만 채우세요.
# APP_PASSWORD = ""
# GEMINI_API_KEY = ""
# FRED_API_KEY = ""
